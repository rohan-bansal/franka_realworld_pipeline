(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language Pick all objects and place in bin)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.28 0.18 -0.26 0.20)
            )
          )
      )
      (target_object_region
          (:target floor)
          (:ranges (
              (0.025 -0.125 0.075 -0.075)
            )
          )
      )
      (other_object_region_1
          (:target floor)
          (:ranges (
              (-0.18 -0.065 -0.16 -0.015)
            )
          )
      )
      (other_object_region_2
          (:target floor)
          (:ranges (
              (-0.22 -0.150 -0.2 -0.100)
            )
          )
      )
      (other_object_region_3
          (:target floor)
          (:ranges (
              (-0.295 -0.125 -0.245 -0.08)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    basket_1 - basket
    chocolate_pudding_1 - chocolate_pudding
    bbq_sauce_1 - bbq_sauce
    salad_dressing_1 - salad_dressing
  )

  (:obj_of_interest
    chocolate_pudding_1
    bbq_sauce_1
    salad_dressing_1
  )

  (:init
    (On chocolate_pudding_1 floor_other_object_region_1)
    (On bbq_sauce_1 floor_other_object_region_2)
    (On salad_dressing_1 floor_other_object_region_3)
    (On basket_1 floor_bin_region)
  )

  (:goal
    (And (In chocolate_pudding_1 basket_1_contain_region) (In bbq_sauce_1 basket_1_contain_region) (In salad_dressing_1 basket_1_contain_region))
  )

)
